cabal-version: 3.0
name: read4k
version: 0.1.0.0
synopsis: Read and copy binary streams in fixed-size chunks
build-type: Simple

common defaults
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wincomplete-uni-patterns -Wincomplete-record-updates
  build-depends: base >=4.14 && <5

library
  import: defaults
  hs-source-dirs: src
  exposed-modules: Read4K
  build-depends: bytestring >=0.10 && <0.13

executable read4k
  import: defaults
  hs-source-dirs: app
  main-is: Main.hs
  build-depends: read4k

test-suite read4k-test
  import: defaults
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Main.hs
  build-depends:
    bytestring >=0.10 && <0.13,
    directory >=1.3 && <1.4,
    read4k
